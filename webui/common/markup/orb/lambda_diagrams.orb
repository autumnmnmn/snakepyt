$css {
    .gallery img {
        width: calc(max(25vw, 64px) - 0.5em);
        height: calc(max(25vw, 64px) - 0.5em);
        padding: 0;
        border-radius: 0.25rem;
        border: 0.25rem solid transparent;
    }

    .gallery img:hover {
        border: 0;
        clip-path: inset(0) !important;
    }

    .gallery {
        margin-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 0px;
        width: fit-content;
    }

    .interactive-plot {
        width: 100%;
        height: 500px;
    }

    @media (min-width: 600px) {
        .gallery img {
            width: calc(max(min(25vw, 512px), 256px) - 0.875em);
            height: calc(max(min(25vw, 512px), 256px) - 0.875em);
        }

        .gallery {
            gap: 0.5em;
        }

    }

    @media (max-width: 768px) {

        .interactive-plot {
            height: 85vh;
            border-bottom: 3px double var(--main-solid);
            border-top: 3px double var(--main-solid);
        }
    }

    .gallery img:not(.loaded) {
        filter: url(#thumb-blur);
        clip-path: inset(0.25rem);
    }

    #lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: #000a;
        place-items: center;
        z-index: 2;
    }

    #lightbox.open {
        display: grid;
    }

    #lightbox img {
        max-width: 98vw;
        max-height: 98vh;
        object-fit: contain;
    }

    .render-container {
        height: 75vh;
    }

    .carousel {
        display: flex;
        flex-direction: row;
        width: 100%;
        overflow-x: scroll;
        gap: 1em;
    }

    .carousel img {
        max-height: 35vh;
        flex-shrink: 0;
    }

    #explorer {
        margin-top: 1em;
        border-radius: 0.25em;
    }

    #explorer:has(.loadwall) {
        padding-top: 1em;
        padding-bottom: 1em;
    }
}

